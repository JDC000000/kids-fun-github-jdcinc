# dependencies
node_modules/
worker/node_modules/

# builds
.next/
dist/
worker/dist/
out/

# env & secrets — NEVER commit real values (schema lives in .env.example)
.env
.env.*
!.env.example

# vercel / supabase local
.vercel/
.supabase/
supabase/.branches/
supabase/.temp/

# misc
*.log
.DS_Store
coverage/
*.tsbuildinfo

# playwright / e2e (reports, traces, minted session state — never commit tokens)
playwright-report/
test-results/
/tests/e2e/.auth/
/tests/e2e/.artifacts/
.playwright/

# search-cap probe: esbuild bundle, written into the repo root because `pg` stays external and
# must resolve from ./node_modules. Removed on exit, but not if the run is killed.
.search-cap-probe.bundle.mjs
.safety-audit.bundle.mjs
.backfill-scope.bundle.mjs
.backfill-scope-review.bundle.mjs
.citycalendar-recon.bundle.mjs

# §3h backfill-scope harness output: a run artefact containing per-row production findings, not
# source. See docs/worker-fix-backfill-scope.md.
.backfill-scope.json
# §3.4 CityCalendar reconciliation: same — per-row production findings, plus the captured feed
# snapshot the run classified. Artefacts of a run, not source.
.citycalendar-recon*.json
.citycalendar-feed*.json

# M1 §3h withheld-correction (scripts/backfill-scope/m1-withheld-backfill.sh): the esbuild
# output DIRECTORY — this build uses --splitting so the write surface is a separate chunk, which
# means an outdir rather than a single .mjs — and the run's plan artefact, which carries per-row
# production occurrence ids and activity names. Same reason as .backfill-scope.json above: this
# repository is public.
.m1-withheld-backfill-bundle/
.m1-withheld-backfill*.json

# §3h title-gate REVIEW-CANDIDATE queue (scripts/backfill-scope/review-batch.sh): 633 rows of
# live parent-facing catalogue data — activity names and occurrence ids pulled from production.
# This repository is PUBLIC. The generator and its tests are source and are committed; the
# generated queue is an operator artefact and is not, for the same reason .backfill-scope.json
# and /.snapshots/ are not.
.backfill-scope-review/

# safety-auditor output (a run artefact, not source — see docs/safety-auditor.md)
.audit/

# production-shaped DB snapshots (scripts/snapshot/). Anonymised, but still real catalogue
# data pulled from a live database — it is an artefact an operator produces and ships out of
# band, never something that belongs in git history where it cannot be deleted.
/.snapshots/

# Throwaway reviewer/verification probes — see TEST_INCLUDE in vitest.workspace.ts.
# The README is tracked (it documents the convention); the probes themselves never are.
.qa-probes/*
!.qa-probes/README.md

# Legacy in-repo backup directories from the incident toolkit's FIRST (wrong) design. Nothing
# writes here any more — backups now go to a per-run directory outside the repo — but the leftover
# files hold REAL PRODUCTION ROW VALUES and must never enter the tree. Kept ignored rather than
# deleted: this toolkit does not delete files it cannot prove it owns.
scripts/incident/**/backups/
