# dependencies
node_modules/
worker/node_modules/

# builds
.next/
dist/
worker/dist/
out/

# env & secrets — NEVER commit real values (schema lives in .env.example)
.env
.env.*
!.env.example

# vercel / supabase local
.vercel/
.supabase/
supabase/.branches/
supabase/.temp/

# misc
*.log
.DS_Store
coverage/
*.tsbuildinfo

# playwright / e2e (reports, traces, minted session state — never commit tokens)
playwright-report/
test-results/
/tests/e2e/.auth/
/tests/e2e/.artifacts/
.playwright/

# search-cap probe: esbuild bundle, written into the repo root because `pg` stays external and
# must resolve from ./node_modules. Removed on exit, but not if the run is killed.
.search-cap-probe.bundle.mjs
.safety-audit.bundle.mjs
.backfill-scope.bundle.mjs

# §3h backfill-scope harness output: a run artefact containing per-row production findings, not
# source. See docs/worker-fix-backfill-scope.md.
.backfill-scope.json

# safety-auditor output (a run artefact, not source — see docs/safety-auditor.md)
.audit/

# production-shaped DB snapshots (scripts/snapshot/). Anonymised, but still real catalogue
# data pulled from a live database — it is an artefact an operator produces and ships out of
# band, never something that belongs in git history where it cannot be deleted.
/.snapshots/
