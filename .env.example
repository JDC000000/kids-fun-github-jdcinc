# KIDS FUN — environment variable schema (NAMES ONLY — never commit values).
# Real values live in the Credential Vault (see docs/credentials.md) and are injected
# per-environment (staging / production) via Vercel + the worker runtime, not this file.
# TSD §3A.1 (Secrets), §3A.3 (three-env model). Zero secrets are committed to this repo.

# --- App / environment ---------------------------------------------------------
NEXT_PUBLIC_APP_ENV=            # development | staging | production
NEXT_PUBLIC_SITE_URL=           # https://staging.kidsfun... | https://kidsfun...

# --- Supabase (per-environment project) ----------------------------------------
SUPABASE_URL=                   # https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=              # public anon key (browser-safe)
SUPABASE_SERVICE_ROLE_KEY=      # server-only; NEVER exposed to the client
DATABASE_URL=                   # SERVICE-LEVEL postgres connection (migrations/CI/worker/
                                 #   admin-guard) — bypasses RLS by design. Never use for
                                 #   user_profile/saved_search CRUD; see USER_DATABASE_URL.
USER_DATABASE_URL=              # RLS-enforcing connection (low-privilege `authenticated`
                                 #   role) for lib/db/user-scoped-client.ts's withUserContext().
                                 #   Required before any real user_profile/saved_search CRUD
                                 #   ships (code review 2026-07-13, backend-auth-rls blocker 2).

# --- Auth (Google OAuth via Supabase Auth; D-4 default = reuse THE WIP pattern) -
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Maps / geocoding (Mapbox or geocoding provider; needed by G-T4-4) ----------
NEXT_PUBLIC_MAP_KEY=            # public map/tiles key
GEOCODING_API_KEY=             # server-side geocoding key

# --- Email (Resend; weekly update email NR-05) ---------------------------------
RESEND_API_KEY=

# --- Observability (Sentry; M6 / G-T1-3) ---------------------------------------
SENTRY_DSN=
SENTRY_AUTH_TOKEN=             # source-map upload token (CI only)

# --- Ingestion worker ----------------------------------------------------------
WORKER_HEALTHZ_PORT=8080
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
