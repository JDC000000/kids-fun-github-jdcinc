# KIDS FUN — environment variable schema (NAMES ONLY — never commit values).
# Real values live in the Credential Vault (see docs/credentials.md) and are injected
# per-environment (staging / production) via Vercel + the worker runtime, not this file.
# TSD §3A.1 (Secrets), §3A.3 (three-env model). Zero secrets are committed to this repo.

# --- App / environment ---------------------------------------------------------
NEXT_PUBLIC_APP_ENV=            # development | staging | production
NEXT_PUBLIC_SITE_URL=   # https://kidsfunapp.ca (production — must be EXACTLY this in the Vercel prod project; siteUrl() throws otherwise when SMS sending is on)

# --- Supabase (per-environment project) ----------------------------------------
SUPABASE_URL=                   # https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=              # public anon key (browser-safe)
SUPABASE_SERVICE_ROLE_KEY=      # server-only; NEVER exposed to the client
DATABASE_URL=                   # SERVICE-LEVEL postgres connection (migrations/CI/worker/
                                 #   admin-guard) — bypasses RLS by design. Never use for
                                 #   user_profile/saved_search CRUD; see USER_DATABASE_URL.
USER_DATABASE_URL=              # RLS-enforcing connection (low-privilege `authenticated`
                                 #   role) for lib/db/user-scoped-client.ts's withUserContext().
                                 #   Required before any real user_profile/saved_search CRUD
                                 #   ships (code review 2026-07-13, backend-auth-rls blocker 2).

# --- Auth (Google OAuth via Supabase Auth; D-4 default = reuse THE WIP pattern) -
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Maps / geocoding (Mapbox or geocoding provider; needed by G-T4-4) ----------
NEXT_PUBLIC_MAP_KEY=            # public map/tiles key
GEOCODING_API_KEY=             # server-side geocoding key

# --- Email (Resend; weekly update email NR-05) ---------------------------------
RESEND_API_KEY=                 # Resend API key (vault slug: kids-fun-resend)
EMAIL_FROM=                     # verified From, e.g. "KIDS FUN <hello@mail.kidsfun...>"
WEEKLY_EMAIL_UNSUBSCRIBE_SECRET= # HMAC secret for one-click unsubscribe tokens (CASL)
WEEKLY_EMAIL_CRON_SECRET=       # shared secret guarding POST /api/email/weekly/run
WEEKLY_EMAIL_ENABLED=           # "true" to permit REAL sends; anything else = dry-run only

# --- SMS (Twilio; SMS-primary weekly pivot) — DRAFT, not provisioned -----------
# Every name below is UNSET on purpose. The Operator provisions the vault credentials; until
# then the inbound webhook rejects every request (no auth token = verify nothing) and the
# pipeline is dry-run (SMS_SENDING_ENABLED unset). Both are the intended unconfigured states.
SMS_SENDING_ENABLED=            # "true" to permit REAL sends AND real inbound consent writes;
                                #   anything else = dry-run. Default FALSE. An SMS mistake is
                                #   worse than an email one — it cannot be filtered into a
                                #   folder, and an unwanted commercial text IS the CASL breach.
SMS_SIGNUP_ENABLED=             # "true" to expose the public signup form + POST /api/sms/signup.
                                #   Default FALSE (PRD §2.1: the form stays behind a flag until
                                #   the privacy/CASL sign-off gate is recorded). SEPARATE from
                                #   SMS_SENDING_ENABLED so staging can run SIGNUP=true +
                                #   SENDING=false — the form renders and validates for real, for
                                #   the Toll-Free Verification screenshot, while dispatching
                                #   nothing and writing no consent row.
INSTANT_PICKS_SMS_SEND_ENABLED= # "true" to let an Instant Picks press DISPATCH a text (plan
                                #   v2.0 §6 option B). Default FALSE, and HELD: the frequency
                                #   disclosure still says "1 message per week" and the Toll-Free
                                #   Verification filing's opt-in evidence is a screenshot of the
                                #   page rendering it. SEPARATE from SMS_SENDING_ENABLED because
                                #   that one is already true in production (it gates the Friday
                                #   send) and so cannot hold anything back. Not the only gate:
                                #   the send also requires consent_text_version >= v8 and must
                                #   pass its own fail-closed throttle.
TWILIO_ACCOUNT_SID=             # Twilio account SID
TWILIO_AUTH_TOKEN=              # SECRET. Verifies X-Twilio-Signature on inbound webhooks and
                                #   authenticates outbound API calls. Never rendered or logged.
TWILIO_MESSAGING_SERVICE_SID=   # Messaging Service that owns the sending number(s)
SMS_WEBHOOK_PUBLIC_URL=         # the EXACT public URL Twilio is configured to POST to, e.g.
                                #   https://kidsfun.../api/sms/inbound. Configured, never
                                #   inferred from request headers — the signature is computed
                                #   over this string, so inferring it means letting a caller
                                #   shape the input to its own auth check. Must match the
                                #   Twilio console value character for character.
SMS_STATUS_CALLBACK_URL=        # the EXACT public URL sent to Twilio as StatusCallback on every
                                #   outbound message, e.g. https://kidsfun.../api/sms/status.
                                #   ONE value serves both ends: it is what we hand Twilio, and
                                #   what the delivery-status webhook verifies its signature
                                #   against — Twilio signs over the URL it was given, so the two
                                #   must match character for character. SEPARATE from
                                #   SMS_WEBHOOK_PUBLIC_URL: different route, different console
                                #   field. Unset = no delivery receipts requested; sends still
                                #   work, sms_send_log.delivery_status just never fills in.
SMS_CRON_SECRET=                # shared secret guarding POST /api/sms/weekly/run. SEPARATE from
                                #   WEEKLY_EMAIL_CRON_SECRET: rotating one must not silently
                                #   disarm the other, and a credential that triggers real text
                                #   messages is not the same blast radius as one that triggers
                                #   emails. Unset = the route 503s (fail closed).
SMS_SHORT_LINK_SECRET=          # HMAC secret for weekly short-link tokens (lib/sms/short-link.ts)
SMS_PREFERENCES_SECRET=         # HMAC secret for the no-login preferences token on sms_consent
SMS_PHONE_HASH_SALT=            # secret salt for sms_send_log.phone_hash. SEPARATE from the two
                                #   secrets above deliberately: those mint links and may be
                                #   rotated freely, this one anonymises a CASL audit trail and
                                #   rotating it orphans every hash ever written.

# --- Analytics & retention (M5 / T31) ------------------------------------------
ANALYTICS_RETENTION_DAYS=       # retention window for analytics_event, in days.
                               #   Default 395 (~13 months), matches the DB DEFAULT
                               #   in migration 0006. Floored at 1 day.
ANALYTICS_RETENTION_CRON_SECRET= # shared secret guarding POST /api/analytics/retention/run
ANALYTICS_RETENTION_DRY_RUN=    # "true" forces the retention job to COUNT ONLY
                               #   (delete nothing); unset/false = actually deletes.

# --- Admin dashboard snapshots (precomputed /admin/* payloads) ------------------
# The /admin/dashboard, /admin/product-health and /admin/operating payloads are computed
# on a schedule into admin_dashboard_snapshot (migration 0050) and READ by the pages,
# rather than recomputed per page load. Measured 2026-09-18 at 2,965,374 analytics_event
# rows: /admin/operating could not load at all (45,820 ms, two reads over their ceiling),
# and 99.98% of rows fall inside its 30-day review window so no date bound helps.
# Unset secret => the refresh route 503s and the pages show "no snapshot yet".
ADMIN_SNAPSHOT_CRON_SECRET=     # shared secret guarding POST /api/admin/snapshot/refresh/run.
                               #   SEPARATE from the other *_CRON_SECRETs on purpose: this one
                               #   triggers ~3.5 min of database work, so it must be rotatable
                               #   without touching the subscriber-facing send jobs.

# --- Correction-report retention (F-6 / PIPEDA data-minimisation) ---------------
# Purge job for correction_report rows past retained_until (DB DEFAULT now()+6 months,
# migration 0020). Same secret-guarded recurring-job pattern as analytics retention.
# The window is NOT an env var: it lives in the migration DB DEFAULT (correction rows
# are stamped by that default, not the app writer), so only the operational knobs below
# are configurable here.
CORRECTION_RETENTION_CRON_SECRET= # shared secret guarding POST /api/corrections/retention/run
CORRECTION_RETENTION_DRY_RUN=   # operator kill-switch: forces the retention job to COUNT
                               #   ONLY (delete nothing). UNSET = it actually deletes —
                               #   that default is deliberate and unchanged, because the
                               #   privacy page's automatic-deletion promise depends on it.
                               #   PAUSE with any of: true/t/yes/y/on/1 (case-insensitive,
                               #   whitespace trimmed). DELETE with false/f/no/n/off/0.
                               #   ANYTHING ELSE non-empty resolves to PAUSE and logs a
                               #   warning — an unrecognised value in front of a permanent
                               #   delete fails safe. It used to be an exact "true" match,
                               #   so "TRUE" and "1" silently DELETED (F1); the resolved
                               #   mode is now logged wherever the job starts.

# --- LLM-assisted batch job (T14-2 dedup adjudication + T13-5 age fallback) -----
# Nightly off-peak Message-Batches job (claude-haiku-4-5 ONLY). Detection-only until
# an operator provisions the Anthropic credential AND sets LLM_BATCH_ENABLED=true.
LLM_BATCH_CRON_SECRET=          # shared secret guarding POST /api/llm/batch/run
LLM_BATCH_ENABLED=              # "true" permits REAL batch submission; else DRY-RUN only
LLM_BATCH_DRY_RUN=              # "true" forces dry-run (detection only, no writes/API call)
LLM_BATCH_MODEL=                # override the model; MUST be a Haiku model.
                               #   Default + requirement: claude-haiku-4-5.
LLM_BATCH_MAX_CANDIDATES=       # per-run candidate cap (default 500) — bounds cost/blast radius
ANTHROPIC_API_KEY=              # Haiku-scoped key (credential slug `kids-fun-anthropic`).
                               #   UNSET today: the batch client is "unprovisioned" and
                               #   throws on use, so a live API call is impossible by accident.

# --- Observability (Sentry; M6 / G-T1-3) ---------------------------------------
NEXT_PUBLIC_SENTRY_DSN=        # Sentry DSN — inlined into the browser bundle (a
                               #   Sentry DSN is public by design). Set this to
                               #   enable client + server + edge error capture.
SENTRY_DSN=                    # optional server-only DSN; falls back to
                               #   NEXT_PUBLIC_SENTRY_DSN when unset.
SENTRY_ORG=                    # Sentry org slug — CI source-map upload AND the
                               #   /admin/operating issue-trend read (M7 / T41).
SENTRY_PROJECT=                # Sentry project slug — same two consumers as above.
SENTRY_AUTH_TOKEN=             # source-map upload token (CI only)
SENTRY_ISSUES_API_TOKEN=       # READ-ONLY Sentry API token for the operating
                               #   dashboard's issue trend (M7 / T41). Scopes:
                               #   project:read, event:read — nothing more.
                               #   DELIBERATELY SEPARATE from SENTRY_AUTH_TOKEN:
                               #   that one is CI-only and is a source-map WRITE
                               #   token, which is the wrong credential to hand a
                               #   long-lived web process. Unset ⇒ the issue-trend
                               #   panel honestly reports "not configured" rather
                               #   than rendering zeros. See docs/kpi-cadence.md §7.
SENTRY_API_BASE_URL=           # optional; defaults to https://sentry.io. Override
                               #   only for a self-hosted / regional Sentry install.
SENTRY_OBSERVED_SINCE=         # optional ISO-8601 date/instant (e.g. 2026-07-14)
                               #   marking when this Sentry project actually started
                               #   being watched. Days in the trend that closed BEFORE
                               #   it read as an em-dash instead of "0 new issues",
                               #   so an unwatched day is never mistaken for a quiet
                               #   one. UNSET (the default) suppresses nothing and is
                               #   the correct value unless you know the date — the
                               #   issue list cannot tell us, and guessing it from the
                               #   earliest issue would wrongly hide genuinely quiet
                               #   days. See docs/kpi-cadence.md §7.

# --- Ingestion worker ----------------------------------------------------------
WORKER_HEALTHZ_PORT=8080
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# --- Live-source allow-lists (fail-closed; ALL are deliberately UNSET here) -----
# Every live adapter is gated behind BOTH the DB terms gate (source.terms_status +
# robots_status) AND a comma-separated env allow-list naming the exact source key.
# Absent or empty => the adapter returns fixtures and makes ZERO network calls, so a
# fresh clone / dev box / CI run is fixture-only by default. Setting one of these is
# an explicit, per-environment decision — see docs/source-register.md.
#
# KIDS_FUN_LIVE_LIBRARY_SYSTEMS=   # e.g. vpl,rpl,nvdpl — `nvdpl` additionally requires
#                                  #   decision record D-12: NVDPL's robots.txt is
#                                  #   UNREADABLE (HTTP 403, Cloudflare challenge),
#                                  #   which is fail-closed under this project's own
#                                  #   T11 precedent. Jon accepted that risk for
#                                  #   NVDPL BY NAME on 2026-07-31; it is NOT a general
#                                  #   'unreadable robots.txt is fine' policy and does
#                                  #   not reopen the T11 Aquarium exclusion.
# KIDS_FUN_LIVE_CITY_CALENDARS=    # e.g. vancouver
# KIDS_FUN_LIVE_VENUES=            # e.g. hr-macmillan-space-centre
# KIDS_FUN_LIVE_ACTIVENET=         # e.g. vancouver,burnaby — ActiveCommunities
#                                  #   rec-portal drop-in schedules (T7). Authority:
#                                  #   decisions_register D-10, an explicit business
#                                  #   override of ACTIVE Network's Terms of Use
#                                  #   prohibition on automated portal access. Read
#                                  #   docs/source-register.md §6.3 BEFORE setting
#                                  #   this in any environment. `west_vancouver` is
#                                  #   inert here: it has zero drop-in calendars and
#                                  #   config keeps it off regardless.
# KIDS_FUN_LIVE_PERFECTMIND=       # e.g. nvrc — PerfectMind/Xplor BookMe4 rec-portal
#                                  #   drop-in schedules (T8). Same authority as
#                                  #   above: decisions_register D-10/D-11. Read
#                                  #   docs/source-register.md §6.4 BEFORE setting
#                                  #   this in any environment. `richmond` is inert
#                                  #   here: it has NO drop-in category (its widget
#                                  #   is registration-only, verified 2026-07-31)
#                                  #   and config keeps it off regardless.
# KIDS_FUN_LIVE_EVENTBRITE=        # e.g. <organizerKey> — organizer-scoped Eventbrite
#                                  #   partner feeds (T10 / G-T10-2). INERT TODAY: zero
#                                  #   organizers are authorised, so
#                                  #   EVENTBRITE_ORGANIZERS is empty and this variable
#                                  #   has nothing to name. See docs/source-register.md
#                                  #   §6.5. Unlike every other family above, this one
#                                  #   ALSO needs a per-organizer credential (below) —
#                                  #   naming a key here without one keeps it off.
# KIDS_FUN_EVENTBRITE_TOKEN_<KEY>= # the organizer's own Eventbrite token, one env var
#                                  #   per organizer, named from its config key (e.g.
#                                  #   organizerKey `acme_arts` => ..._TOKEN_ACME_ARTS).
#                                  #   Sent ONLY as an Authorization bearer header,
#                                  #   never in a URL. Absent/empty => not live, zero
#                                  #   network calls.

# ── Search read-path caches (performance) ────────────────────────────────────
# Short in-process TTL caches in front of the three DB loads /api/search makes. The listing
# cache defaults to 600000 (10 min), the other two to 60000 (60s); all are parsed by
# lib/search/ttl-cache.ts: a blank or unparseable value uses the default AND logs a warning;
# an explicit `0` disables that cache entirely (every request reloads). Leaving them unset is
# correct for every environment — they exist so a cache can be shortened or turned off during
# an incident without a code change (on Vercel an env change still needs a redeploy to apply).
# KIDS_FUN_LISTING_CACHE_MS=       # the visible catalogue read model (the expensive one:
#                                  #   ~428ms of a 560ms request against live staging, and
#                                  #   the whole catalogue in egress on every reload — which
#                                  #   is why its default is 10 min, not 60s)
# KIDS_FUN_ALIAS_CACHE_MS=         # the synonym_alias dictionary
# KIDS_FUN_REGION_CACHE_MS=        # the region hierarchy
#
# ── Shared catalogue cache (egress Thread 3, Options B + C) ─────────────────────────────────
# In front of the listing cache above sits a SHARED, version-gated catalogue cache: one instance
# loads the catalogue and publishes it (brotli-compressed) to Vercel's Data Cache; every other
# instance reads it from there. A ~100-byte content-hash probe decides whether a reload is needed.
# See lib/search/shared-catalogue-cache.ts for the design and the staleness it trades. Leave all
# three unset in every environment unless there is a reason not to.
# KIDS_FUN_CATALOGUE_SHARED_CACHE= # KILL SWITCH. unset/`on` = shared cache on; `off` = the
#                                  #   per-instance listing cache above, exactly as before. Any
#                                  #   other value is treated as `off` (with a warning).
#                                  #   Vercel: an env change needs a redeploy to apply.
# KIDS_FUN_CATALOGUE_PROBE_MS=     # how often the content version is re-derived in the database
#                                  #   (default 21600000 = 6 h, Jon 2026-09-23; min 30000 — each
#                                  #   probe is a catalogue-sized query of DB CPU). Without a manual
#                                  #   bust, a content change reaches search within ~6 h + 2 min.
# KIDS_FUN_CATALOGUE_FRESHNESS_FLOOR_MS= # full reload at least this often even if nothing changed,
#                                  #   for "checked X ago" (default 86400000 = 24 h; min 60000).
# KIDS_FUN_CATALOGUE_RECHECK_MS=   # how often a warm instance re-reads the SHARED version entry (a
#                                  #   ~100-byte Data Cache read, no DB). Bounds how fast a manual
#                                  #   bust propagates (default 60000; min 5000; <= the probe).
CATALOGUE_CACHE_BUST_SECRET=      # bearer secret for POST /api/admin/catalogue-cache/bust — the
#                                  #   manual bust for an urgent correction (fix the data first,
#                                  #   then bust; every instance serves it within ~2 min). Unset =
#                                  #   only a signed-in admin session can bust.
# NB with the shared cache on, KIDS_FUN_LISTING_CACHE_MS=0 no longer means "reload every request":
# that takes the kill switch off AND KIDS_FUN_LISTING_CACHE_MS=0.

# ── search-cap probe (scripts/search-cap-probe.sh) — operator diagnostic, never the app ──
# KF_PROBE_DATABASE_URL=           # deliberately NOT DATABASE_URL: the local-db guard refuses
#                                  #   non-local DATABASE_URLs and the probe must never be the
#                                  #   reason KIDS_FUN_ALLOW_NONLOCAL_DB is set and left set
# KF_PROBE_ENV=                    # default label stamped on every reported line
# KF_PROBE_ALLOW_SELF_SIGNED_TLS=  # `1` disables TLS certificate verification for the probe.
#                                  #   For a self-signed staging cert ONLY. Never for production.
