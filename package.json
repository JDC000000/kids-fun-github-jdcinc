{
  "name": "kids-fun",
  "version": "0.0.0",
  "private": true,
  "description": "KIDS FUN — Metro Vancouver kids-activity discovery index (Next.js App Router + Supabase).",
  "engines": {
    "node": ">=20 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "bash scripts/test.sh",
    "test:unit": "vitest run --project unit --fileParallelism",
    "test:db": "vitest run --project db",
    "test:invariants": "vitest run --project invariants --fileParallelism",
    "test:watch": "vitest",
    "migrate": "bash scripts/migrate.sh",
    "seed": "bash scripts/seed.sh",
    "db:bootstrap": "bash scripts/local-db-bootstrap.sh",
    "e2e": "playwright test",
    "e2e:report": "playwright show-report",
    "e2e:setup": "bash scripts/e2e/setup-local-supabase.sh",
    "snapshot:export": "bash scripts/snapshot/export.sh",
    "snapshot:verify": "bash scripts/snapshot/verify.sh",
    "snapshot:load": "bash scripts/snapshot/load.sh",
    "snapshot:roundtrip-check": "bash scripts/snapshot/roundtrip-check.sh",
    "test:snapshot": "bash scripts/snapshot/test-with-snapshot.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.112.3",
    "@sentry/nextjs": "10.66.0",
    "@supabase/ssr": "0.12.0",
    "@supabase/supabase-js": "2.110.2",
    "mapbox-gl": "3.26.0",
    "next": "14.2.35",
    "pg": "8.22.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "twilio": "^6.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.61.1",
    "@types/node": "20.14.10",
    "@types/pg": "8.20.0",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "eslint": "8.57.0",
    "eslint-config-next": "14.2.5",
    "typescript": "5.5.3",
    "vitest": "2.0.5"
  }
}
