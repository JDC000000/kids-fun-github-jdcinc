{
  "name": "kids-fun-worker",
  "version": "0.0.0",
  "private": true,
  "description": "KIDS FUN ingestion worker — long-running/containerised Node runtime with headless Chromium (TSD §3A.1, §5). NOT Vercel serverless.",
  "engines": {
    "node": ">=20 <23"
  },
  "type": "commonjs",
  "main": "dist/src/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "dev": "node --loader ts-node/esm src/index.ts",
    "smoke": "node dist/src/chromium-smoke.js",
    "ingest:once": "node dist/src/ingest-once.js"
  },
  "dependencies": {
    "@sentry/node": "^10.66.0",
    "pg": "^8.22.0",
    "puppeteer-core": "22.15.0"
  },
  "devDependencies": {
    "@types/node": "20.14.10",
    "@types/pg": "^8.20.0",
    "typescript": "5.5.3"
  }
}
